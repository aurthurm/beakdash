# BeakDash Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=your_super_secret_session_key_32_characters_min

# Database Configuration
DATABASE_URL=postgresql://beak:beak@localhost:5432/beakdash

# OpenAI API Configuration (Required for Copilot, Agentic BI & Self-Healing)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini